class Solution {
  public:
    bool areRotations(string &s1, string &s2) {
        // code here
        int n1 = s1.size();
        int n2 = s2.size();
        
        if(n1 != n2) return false;
        
        string temp = s1 + s1;
        if(temp.find(s2) != string::npos) {
            return true;
        }else return false;
    }
};
